      "id": "merge-ghl",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "function pick(node){ try { const x = $(node).first(); return (x && x.json) || {}; } catch(e){ return {}; } }\nconst contact = pick('Contact').contact || {};\nconst opps = pick('Opportunities').opportunities || [];\nconst cfDefs = pick('Custom Fields').customFields || [];\nconst pipes = pick('Pipelines').pipelines || [];\nif (!contact.id) return [{ json: { ok:false, contact:null, opportunities:[] } }];\nconst cfName = {}; for (const d of cfDefs) cfName[d.id] = d.name;\nconst pipeName = {}, stageName = {};\nfor (const p of pipes){ pipeName[p.id]=p.name; for (const s of (p.stages||[])) stageName[s.id]=s.name; }\nconst trunc = (v) => { let s = (typeof v === 'string') ? v : JSON.stringify(v); if (s == null) return ''; if (s.length > 1000) s = s.slice(0,1000) + '\\u2026'; return s; };\nconst customFields = (contact.customFields||[]).filter(f => f && f.value != null && f.value !== '' && !(Array.isArray(f.value) && !f.value.length)).map(f => ({ name: cfName[f.id] || f.id, value: trunc(f.value) }));\nconst name = [contact.firstName, contact.lastName].filter(Boolean).join(' ').trim() || contact.contactName || contact.name || '';\nconst opportunities = opps.map(o => ({ id:o.id, name:o.name||'', status:o.status||'', monetaryValue: o.monetaryValue!=null ? o.monetaryValue : null, pipeline: pipeName[o.pipelineId]||'', stage: stageName[o.pipelineStageId]||'', source:o.source||'', createdAt:o.createdAt||null }));\nreturn [{ json: { ok:true, contact: { id:contact.id, name, firstName:contact.firstName||'', lastName:contact.lastName||'', email:contact.email||'', phone:contact.phone||'', companyName:contact.companyName||'', source:contact.source||'', type:contact.type||'', country:contact.country||'', timezone:contact.timezone||'', dnd: !!contact.dnd, dateAdded:contact.dateAdded||null, dateUpdated:contact.dateUpdated||null, tags: contact.tags||[], customFields }, opportunities } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 0],
      "id": "code-ghl-format",
      "name": "Format"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseHeaders": { "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }] } }
      },
      "type": "n8n-nodes-base.respondToWebhook",

{
  "name": "WA · Handoff",
  "nodes": [
    {
      "parameters": { "httpMethod": "GET", "path": "wa-handoff", "responseMode": "responseNode", "options": { "allowedOrigins": "*" } },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "wh-handoff",
      "name": "Webhook",
      "webhookId": "wa-handoff-hook"
    },
    {
      "parameters": { "jsCode": "const q = ($input.first().json.query) || {};\nconst tag = q.tag ? String(q.tag).trim() : 'handoff';\nreturn [{ json: { tag } }];" },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0],
      "id": "code-parse",
      "name": "Parse"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Version", "value": "2021-07-28" }, { "name": "Accept", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { locationId: 'bzRd2deoIdOClJZ44bv5', pageLimit: 100, filters: [ { field: 'tags', operator: 'contains', value: $json.tag } ] } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 0],
      "id": "http-search",
      "name": "Search",
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "OHoYrmCYCVP4RruL", "name": "GHL API (PIT)" } }
    },
    {
      "parameters": { "jsCode": "const r = ($input.first() && $input.first().json) || {};\nconst cs = r.contacts || [];\nconst contactIds = cs.map(c => c.id).filter(Boolean);\nreturn [{ json: { ok: true, contactIds } }];" },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 0],
      "id": "code-format",
      "name": "Format"
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": { "responseHeaders": { "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }] } } },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [860, 0],
      "id": "resp-handoff",
      "name": "Respond"
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Parse", "type": "main", "index": 0 }]] },
    "Parse": { "main": [[{ "node": "Search", "type": "main", "index": 0 }]] },
    "Search": { "main": [[{ "node": "Format", "type": "main", "index": 0 }]] },
    "Format": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
